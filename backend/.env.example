# CleanFlow Backend Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,cleanflow_server=debug

# Database Configuration
# Use memory:// for in-memory store (development)
DATABASE_URL=memory://
# Or for real Postgres:
# DATABASE_URL=postgres://postgres:password@localhost:5432/cleanflow

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-secret-key-here-change-in-production

# OpenAI Configuration (REQUIRED for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Feature Flags
CLEANFLOW_FEATURES=openai_realtime,use-llm-security,use-pdf,use-path-security

# Optional: Threat Intelligence (if using security features)
# CLEANFLOW_THREAT_INTEL_API_KEY=your-threat-intel-api-key